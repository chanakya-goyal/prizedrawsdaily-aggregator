<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces __HOME__ and writes it to ~/Library/LaunchAgents/. -->
<!-- 16:45 and 17:45 Mac time (IST) = 12:15 / 13:15 UK in summer, 11:15 / 12:15 UK in winter. run.sh's
     UK window (12:00-20:00) lets exactly one of them post at 12:15 UK; the other finds it published.
     A run missed while the Mac slept is started on wake; the window stops a night-time catch-up. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>uk.prizedrawsdaily.autopost</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/pdd-autopost/carousel/autopilot/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.bun/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pdd-autopost/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pdd-autopost/launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
